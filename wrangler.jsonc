{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "./cloudflare-worker-entry.mjs",
	"name": "jerry-can-spirits-prod",
	"compatibility_date": "2026-05-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Public GA4 measurement ID (visible in page source, not a secret).
		// The paired GA4_API_SECRET is set via `wrangler secret put`.
		"GA4_MEASUREMENT_ID": "G-6VJL06YBW2"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "jerry-can-spirits-prod"
		}
	],
	"kv_namespaces": [
		{
			"binding": "COCKTAIL_RATINGS",
			"id": "3498c4961e59446cbc703b8ed19852c0",
			"preview_id": "3498c4961e59446cbc703b8ed19852c0"
		},
		{
			// SITE_OPS: feature flags, age verification cache, visitor tracking
			"binding": "SITE_OPS",
			"id": "83fc738dbd204f17b809fb3edcd74a62",
			"preview_id": "83fc738dbd204f17b809fb3edcd74a62"
		}
	],
	"d1_databases": [
		{
			// D1: batch data, bottle tracking, batch followers
			// Create with: wrangler d1 create jerry-can-spirits-db
			"binding": "DB",
			"database_name": "jerry-can-spirits-db",
			"database_id": "35c6ef4c-fab0-4666-9065-052b84ecdb9a"
		},
		{
			// OpenNext tag cache (open-next.config.ts): a second binding on the same
			// database, read by the D1 next-mode tag cache so revalidatePath from
			// the Sanity and Shopify webhooks takes effect instead of being a no-op.
			// The deploy populateCache step creates the revalidations table.
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "jerry-can-spirits-db",
			"database_id": "35c6ef4c-fab0-4666-9065-052b84ecdb9a"
		}
	],
	"r2_buckets": [
		{
			// Trade application supporting documents (premises licence, director ID)
			// Lifecycle rules configured in Cloudflare dashboard:
			//   pending/      → delete after 24h
			//   applications/ → delete after 30 days
			"binding": "TRADE_DOCS",
			"bucket_name": "jerry-can-spirits-trade-docs"
		},
		{
			// OpenNext incremental cache: stores regenerated ISR pages so
			// expired long-tail pages serve from cache instead of paying a
			// full origin render on every request (Ahrefs flagged 2-3s TTFB
			// for AI crawlers on exactly those pages).
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "jerry-can-spirits-inc-cache"
		}
	],
	// Which deploy is this. The edge cache in cloudflare-worker-entry.mjs
	// keys on it, so a new deploy cannot serve HTML naming the hashed assets
	// of the build before it.
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"triggers": {
		"crons": ["0 8 * * 1", "0 * * * *"]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		}
	}
}